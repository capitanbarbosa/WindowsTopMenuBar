<Window x:Class="WindowsWhisker.Views.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WindowsWhisker.Controls"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        Background="#1E2D45">
    <Border x:Name="Frame" Background="Transparent" BorderBrush="#66000000" BorderThickness="0,0,0,1" ClipToBounds="True">
        <controls:StripPanel x:Name="Strip" Background="Transparent"/>
    </Border>
</Window>
